		{
			static uint32_t oled_tick = 0;
			if (HAL_GetTick() - oled_tick >= 300)
			{
				oled_tick = HAL_GetTick();
				OLED_Clear();
				OLED_Printf(0,  0, OLED_6X8, "mode:%d", mode);
				OLED_Printf(0,  8, OLED_6X8, "SL:%.3f", walk_param.step_length[0]);
				OLED_Printf(0, 16, OLED_6X8, "TR:%.3f", walk_param.turn_rate);
				OLED_Update();
			}
		}
    
		if(RC_Ctl.rc.sw>=1300){dog_Go_int();}

		switch(RC_Ctl.rc.s1) {
		  case 1:{
				switch(RC_Ctl.rc.s2) {
				   case 1:{
						  if(flag_mode==0){
							walk_param.stance_height[0]=-0.219f;walk_param.stance_height[1]=-0.219f;
							walk_param.stance_height[2]=-0.219f;walk_param.stance_height[3]=-0.219f;
							walk_param.step_height[0]=0.06f;walk_param.step_height[1]=0.06f;
							walk_param.step_height[2]=0.06f;walk_param.step_height[3]=0.06f;
