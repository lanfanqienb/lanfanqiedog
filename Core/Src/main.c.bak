									    else if(flag1==4){dog_forward_bit_out();flag1=0;flag0=0;}}
									
							    
                  if(RC_Ctl.rc.ch3>=1300){
											if(flag0==0){dog_forward_bit_int();flag0=1;}
											dog_squat_dir(0.0012,0.0003);flag1=4;}//0.0003,0.000075   0.0006,0.00015
									else if(RC_Ctl.rc.ch2 <= 600){
