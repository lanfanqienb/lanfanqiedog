										else if(RC_Ctl.rc.ch0>=1200){
											if(flag0==0){dog_right_rear_int();flag0=1;}dog_right_rear(0.0006,0.00015);flag1=10;}
								    else if(RC_Ctl.rc.ch3<=600){dog_rear_flip();}}
																								
			     break;}}
      break;}	
			case 3:{
				 switch(RC_Ctl.rc.s2) {
					 case 1:{
						  if(flag_mode==0){
							walk_param.stance_height[0]=-0.219f;walk_param.stance_height[1]=-0.219f;
							walk_param.stance_height[2]=-0.219f;walk_param.stance_height[3]=-0.219f;
