								walk_param.step_length[0]=_sl;walk_param.step_length[1]=_sl;
								walk_param.step_length[2]=_sl;walk_param.step_length[3]=_sl;
								walk_param.turn_rate=(_c2>100||_c2<-100)?(float)_c2/660.0f*0.13f:0.0f;
								walk_param.term=0.32f;
