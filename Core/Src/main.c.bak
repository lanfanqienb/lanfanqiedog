/**************************************�жϻص�����**************************************/
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
	if(htim->Instance == TIM6) {
		#define IK_Z_STEP 0.0005f  /* 每 20ms 最多移动 0.5mm */
		if (mode == 5) {
			/* ---- 力控站立模式 (mode=5) ----
			 * 目标足端 z=-0.22m（物理FK验证值），x=0
			 * 每中断更新全�???4条腿，按FLAH轮流发�?�力矩（分散CAN带宽�??? */
			for (int i = 0; i < 4; i++) {
				fc_leg[i].Foot_Target.x = fc_leg[i].Foot.x;  /* 以当前x为目标，不产生多余横向力 */
				fc_leg[i].Foot_Target.z = -0.22f;
				FC_Update_Leg(i, &fc_pd_stand);
			}
			FC_Send_Torque(FLAH);
			FLAH = (FLAH + 1) & 3;
		} 
		else if (mode == 1) {
		/* ---- IK位控站立（各腿独立高度）----
		 * ik_z_target[i] 控制第 i 条腿 z；直接赋值，中断自动平滑插值
		 * 腿编号：0=右后,1=左前,2=左后,3=右前 */
		for (int i = 0; i < 4; i++) {
			if      (ik_z[i] < ik_z_target[i] - IK_Z_STEP) ik_z[i] += IK_Z_STEP;
			else if (ik_z[i] > ik_z_target[i] + IK_Z_STEP) ik_z[i] -= IK_Z_STEP;
			else     ik_z[i] = ik_z_target[i];
			fc_leg[i].Foot_Target.x = 0.0f;
			fc_leg[i].Foot_Target.z = ik_z[i];
			FC_Kinematic_Inversion(&fc_leg[i]);
		}
		FC_Send_Pos_Slot(FLAH, 0.5f, 0.01f);
		FLAH = (FLAH + 1) & 3;
		}
		else if (mode == 2 || mode == 3) {
		/* ---- Bezier步�?�行走模�??? ----
		 * mode=2: 手动（ch3/ch2摇杆�???
		 * mode=3: 上位�??? Pure Pursuit 自动导航
		 * step_length/turn_rate 已在 while(1) 写好，这里只负责轨迹执行 */
		static uint8_t mode_walk_last = 0xFF;
		if (mode_walk_last != mode) {
			walk_enter();
		}
		mode_walk_last = mode;
		walk_run(&FLAH);

		} 
		else {
		/* ---- 原始�???单位控模式（默认�???---- */
		if (FLAH == 0) {
			unitree_setpara(&send,0,1,ff_torque[0],0,leg[0],kd,0.01);unitree_CAN_Send(&hcan2,0,11,&send);unitree_CAN_Send(&hcan2,0,10,&send);
			unitree_setpara(&send,2,1,ff_torque[2],0,leg[2],kd,0.01);unitree_CAN_Send(&hcan1,0,11,&send);unitree_CAN_Send(&hcan1,0,10,&send);FLAH = 1;}
		else if (FLAH == 1) {
			unitree_setpara(&send,1,1,ff_torque[1],0,leg[1],kd,0.01);unitree_CAN_Send(&hcan2,0,11,&send);unitree_CAN_Send(&hcan2,0,10,&send);
			unitree_setpara(&send,3,1,ff_torque[3],0,leg[3],kd,0.01);unitree_CAN_Send(&hcan1,0,11,&send);unitree_CAN_Send(&hcan1,0,10,&send);FLAH = 2;}
		else if (FLAH == 2) {
			unitree_setpara(&send,4,1,ff_torque[4],0,leg[4],kd,0.01);unitree_CAN_Send(&hcan1,0,11,&send);unitree_CAN_Send(&hcan1,0,10,&send);
			unitree_setpara(&send,6,1,ff_torque[6],0,leg[6],kd,0.01);unitree_CAN_Send(&hcan2,0,11,&send);unitree_CAN_Send(&hcan2,0,10,&send);FLAH = 3;}
		else if (FLAH == 3) {
			unitree_setpara(&send,5,1,ff_torque[5],0,leg[5],kd,0.01);unitree_CAN_Send(&hcan1,0,11,&send);unitree_CAN_Send(&hcan1,0,10,&send);
			unitree_setpara(&send,7,1,ff_torque[7],0,leg[7],kd,0.01);unitree_CAN_Send(&hcan2,0,11,&send);unitree_CAN_Send(&hcan2,0,10,&send);FLAH = 0;}
		/* FK观测（位控时也更新足端位置，供调试用�??? */
//		for (int i = 0; i < 4; i++) {
//				FC_Motor_To_Joint(&fc_leg[i]);
//				FC_Kinematic_Solution(&fc_leg[i]);
//		}
		
			
//		if (FLAH==0){ 
//			unitree_setpara(&send,0,1,0,0,0,0,0);unitree_CAN_Send(&hcan1,0,11,&send);unitree_CAN_Send(&hcan1,0,10,&send);
//			unitree_setpara(&send,2,1,0,0,0,0,0);unitree_CAN_Send(&hcan2,0,11,&send);unitree_CAN_Send(&hcan2,0,10,&send);FLAH=1;}
//		else if (FLAH==1){ 
//			unitree_setpara(&send,1,1,0,0,0,0,0);unitree_CAN_Send(&hcan1,0,11,&send);unitree_CAN_Send(&hcan1,0,10,&send);
//			unitree_setpara(&send,3,1,0,0,0,0,0);unitree_CAN_Send(&hcan2,0,11,&send);unitree_CAN_Send(&hcan2,0,10,&send);FLAH=2;}
//		else if (FLAH==2){ 
//			unitree_setpara(&send,4,1,0,0,0,0,0);unitree_CAN_Send(&hcan2,0,11,&send);unitree_CAN_Send(&hcan2,0,10,&send);
//			unitree_setpara(&send,6,1,0,0,0,0,0);unitree_CAN_Send(&hcan1,0,11,&send);unitree_CAN_Send(&hcan1,0,10,&send);FLAH=3;}
//		else if (FLAH==3){ 
//			unitree_setpara(&send,5,1,0,0,0,0,0);unitree_CAN_Send(&hcan2,0,11,&send);unitree_CAN_Send(&hcan2,0,10,&send);
//			unitree_setpara(&send,7,1,0,0,0,0,0);unitree_CAN_Send(&hcan1,0,11,&send);unitree_CAN_Send(&hcan1,0,10,&send);FLAH=0;}
	   }
		}
}

/**************************************ң�������ݽṹ**************************************/
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *UartHandle)
{
	/* USART1：SBUS 遥控器数据解�?? */
		RC_Ctl.rc.ch0 = (sbus_rx_buffer[0]| (sbus_rx_buffer[1] <<8))&0x07ff;
		RC_Ctl.rc.ch1 = ((sbus_rx_buffer[1] >> 3) | (sbus_rx_buffer[2] << 5))&0x07ff;
		RC_Ctl.rc.ch2 = ((sbus_rx_buffer[2] >> 6) | (sbus_rx_buffer[3] << 2)|(sbus_rx_buffer[4]<<10))&0x07ff;
		RC_Ctl.rc.ch3 = ((sbus_rx_buffer[4] >> 1) | (sbus_rx_buffer[5] << 7))&0x07ff;
		RC_Ctl.rc.s1  = ((sbus_rx_buffer[5] >> 4)& 0x000C) >> 2;
		RC_Ctl.rc.s2  = ((sbus_rx_buffer[5] >> 4)& 0x0003);
		RC_Ctl.rc.sw=sbus_rx_buffer[16]|(sbus_rx_buffer[17]<<8);

		RC_Ctl.mouse.x = sbus_rx_buffer[6] | (sbus_rx_buffer[7] << 8);
		RC_Ctl.mouse.y = sbus_rx_buffer[8] | (sbus_rx_buffer[9] << 8);
		RC_Ctl.mouse.z = sbus_rx_buffer[10] | (sbus_rx_buffer[11] << 8);
		RC_Ctl.mouse.press_l = sbus_rx_buffer[12];
		RC_Ctl.mouse.press_r = sbus_rx_buffer[13];
		RC_Ctl.key.v = sbus_rx_buffer[14] | (sbus_rx_buffer[15] << 8);

	/* USART2：已改为 DMA 模式，由 uart_task() 处理，此回调仅用�?? USART1 */
	(void)UartHandle;
}
