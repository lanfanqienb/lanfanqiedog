void dog_small_still(void)
{
			 if(RC_Ctl.rc.ch3==1024&&RC_Ctl.rc.ch2==1024&&RC_Ctl.rc.ch0==1024&&RC_Ctl.rc.ch1==1024&&flag1!=0){
										 if(flag1==8){dog_forward_bit_still_out();flag1=0;flag0=0;}
										else if(flag1==5){dog_back_bit_still_out();flag1=0;flag0=0;}
										else if(flag1==6){dog_left_bit_still_out();flag1=0;flag0=0;}	
           			    else if(flag1==7){dog_right_bit_still_out();flag1=0;flag0=0;}}
			 
	    if(RC_Ctl.rc.ch1>=1300){
			  if(flag0==0){dog_forward_bit_still_int();flag0=1;}
			  dog_forward_bit_still(0.0003,0.000042);flag1=8;}//0.00036,0.00018 0.0003,0.000042
			else if(RC_Ctl.rc.ch1<=600){  
				if(flag0==0){dog_back_bit_still_int();flag0=1;}
				dog_back_bit_still(0.0003,0.000042);flag1=5;}	//0.00036,0.00018
			else if(RC_Ctl.rc.ch0 <= 600){
				if(flag0==0){dog_left_bit_still_int();flag0=1;}
				dog_left_bit_still(0.0003,0.000042);flag1=6;}//0.00036,0.00015
			else if(RC_Ctl.rc.ch0>=1200){
				if(flag0==0){dog_right_bit_still_int();flag0=1;}
				dog_right_bit_still(0.0003,0.000042);flag1=7;}//0.00036,0.00015
}	
