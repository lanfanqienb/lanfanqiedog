										else if(RC_Ctl.rc.ch3>=1300){
											 if(flag2==0){dog_rear_leg();flag2=1;} 
								       if(flag0==0){dog_rear_mid_int();flag0=1;}dog_rear_mid(0.00072,0.00036);flag1=11;}
									  else if(RC_Ctl.rc.ch0<=600){
