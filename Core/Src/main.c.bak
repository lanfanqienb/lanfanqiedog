							}
					 break;}}	
			break;}
			case 2:{
				switch(RC_Ctl.rc.s2) {
					 case 3:{
					 		/* 前高后低 plank，flag_mode=5；中间档，从蹲(1)进入 */
							 if(flag_mode==1){
							 	dog_squat2plank();
							 	/* 同步 ik_z 到 plank 物理位置，避免 IK 插值从错误起点突变 */
							 	ik_z[1]=-0.219f;ik_z[3]=-0.219f;
							 	ik_z[0]=-0.132f;ik_z[2]=-0.132f;
							 	flag_mode=5;}
							 else if(flag_mode==7||flag_mode==8){
							 	/* 从左高/左低斜坡回到 plank，只改 target */
								ik_z_target[1]=-0.219f;ik_z_target[3]=-0.219f; /* 前腿高 */
								ik_z_target[0]=-0.132f;ik_z_target[2]=-0.132f; /* 后腿低 */
								flag_mode=5; mode=1;}
					 		 else if(flag_mode==5){
									walk_param.stance_height[1]=-0.219f;walk_param.stance_height[3]=-0.219f;
									walk_param.stance_height[0]=-0.132f;walk_param.stance_height[2]=-0.132f;
									{int _c3=(int)RC_Ctl.rc.ch3-1024,_c2=(int)RC_Ctl.rc.ch2-1024;
									if(_c3>100||_c3<-100||_c2>100||_c2<-100){
										float _sl_f=(_c3>100||_c3<-100)?(float)_c3/660.0f*0.12f:0.0f;
										float _sl_r=(_c3>100||_c3<-100)?(float)_c3/660.0f*0.07f:0.0f;
										walk_param.step_length[1]=_sl_f;walk_param.step_length[3]=_sl_f;
										walk_param.step_length[0]=_sl_r;walk_param.step_length[2]=_sl_r;
										walk_param.step_height[1]=0.05f;walk_param.step_height[3]=0.05f;
										walk_param.step_height[0]=0.02f;walk_param.step_height[2]=0.02f;
										walk_param.turn_rate=(_c2>100||_c2<-100)?(float)_c2/660.0f*0.08f:0.0f;
										walk_param.term=0.4f;
										mode=2;
									}else{
										ik_z_target[1]=-0.219f;ik_z_target[3]=-0.219f;
										ik_z_target[0]=-0.132f;ik_z_target[2]=-0.132f;
										mode=1;}}}
					 break;}
					 case 2:{
					 		/* 左高右低 flag_mode=7；经由 plank(5) 或左低(8) 进入 */
							 if(flag_mode==5||flag_mode==8){
								ik_z_target[1]=-0.219f;ik_z_target[2]=-0.219f; /* 左腿高 */
								ik_z_target[0]=-0.132f;ik_z_target[3]=-0.132f; /* 右腿低 */
								flag_mode=7; mode=1;}
					 		 else if(flag_mode==7){
									walk_param.stance_height[1]=-0.219f;walk_param.stance_height[2]=-0.219f;
									walk_param.stance_height[0]=-0.132f;walk_param.stance_height[3]=-0.132f;
									{int _c3=(int)RC_Ctl.rc.ch3-1024,_c2=(int)RC_Ctl.rc.ch2-1024;
									if(_c3>100||_c3<-100||_c2>100||_c2<-100){
										float _sl=(_c3>100||_c3<-100)?(float)_c3/660.0f*0.09f:0.0f;
										walk_param.step_length[0]=_sl;walk_param.step_length[1]=_sl;
										walk_param.step_length[2]=_sl;walk_param.step_length[3]=_sl;
										walk_param.step_height[1]=0.05f;walk_param.step_height[2]=0.05f; /* 左腿高 */
										walk_param.step_height[0]=0.02f;walk_param.step_height[3]=0.02f; /* 右腿低 */
										walk_param.turn_rate=(_c2>100||_c2<-100)?(float)_c2/660.0f*0.08f:0.0f;
										walk_param.term=0.4f;
										mode=2;
									}else{
										ik_z_target[1]=-0.219f;ik_z_target[2]=-0.219f;
										ik_z_target[0]=-0.132f;ik_z_target[3]=-0.132f;
										mode=1;}}}
					 break;}
					 case 1:{
					 		/* 左低右高 flag_mode=8；经由 plank(5) 或左高(7) 进入 */
							 if(flag_mode==5||flag_mode==7){
								ik_z_target[0]=-0.219f;ik_z_target[3]=-0.219f; /* 右腿高 */
								ik_z_target[1]=-0.132f;ik_z_target[2]=-0.132f; /* 左腿低 */
								flag_mode=8; mode=1;}
							 else if(flag_mode==8){
								walk_param.stance_height[0]=-0.219f;walk_param.stance_height[3]=-0.219f;
								walk_param.stance_height[1]=-0.132f;walk_param.stance_height[2]=-0.132f;
								{int _c3=(int)RC_Ctl.rc.ch3-1024,_c2=(int)RC_Ctl.rc.ch2-1024;
								if(_c3>100||_c3<-100||_c2>100||_c2<-100){
									float _sl=(_c3>100||_c3<-100)?(float)_c3/660.0f*0.09f:0.0f;
									walk_param.step_length[0]=_sl;walk_param.step_length[1]=_sl;
									walk_param.step_length[2]=_sl;walk_param.step_length[3]=_sl;
									walk_param.step_height[0]=0.05f;walk_param.step_height[3]=0.05f; /* 右腿高 */
									walk_param.step_height[1]=0.02f;walk_param.step_height[2]=0.02f; /* 左腿低 */
									walk_param.turn_rate=(_c2>100||_c2<-100)?(float)_c2/660.0f*0.08f:0.0f;
									walk_param.term=0.4f;
