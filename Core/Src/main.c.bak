											dog_back_squat(0.0006,0.00015);flag1=3;}dog_small_still();}
							else if(flag_mode==5){dog_plank2squat();flag_mode=1;}
					 break;}
					 case 2:{
						 mode=0;	 
						 if(flag_mode==1){
									if(RC_Ctl.rc.ch3>=1300){dog_jump_force10(6.5f,(fp32[]){7.0f,7.0f,7.6f,7.6f,7.6f,7.6f,7.0f,7.0f});flag_mode=2;HAL_Delay(600);}
									else if(RC_Ctl.rc.ch3<=600){dog_double_jump_force2();flag_mode=2;HAL_Delay(600);}
                  else if(RC_Ctl.rc.ch2<=600){dog_treble_jump_force2();flag_mode=2;HAL_Delay(600);}
								  
//                  else if(RC_Ctl.rc.ch1>=1300){dog_double_jump_force();flag_mode=2;HAL_Delay(300);}
//                  else if(RC_Ctl.rc.ch1<=600){dog_bunny_jump_force6(8.5f,(fp32[]){9.0f,9.0f,10.5f,10.5f,10.0f,10.0f,9.0f,9.0f});flag_mode=2;HAL_Delay(300);}
