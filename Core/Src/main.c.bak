}	
void dog_mid(void)
{
			 if(RC_Ctl.rc.ch3==1024&&RC_Ctl.rc.ch2==1024&&RC_Ctl.rc.ch0==1024&&RC_Ctl.rc.ch1==1024&&flag1!=0){
										 if(flag1==8){dog_forward_mid_out();flag1=0;flag0=0;}
										else if(flag1==5){dog_back_mid_out();flag1=0;flag0=0;}
										else if(flag1==6){dog_left_mid_out();flag1=0;flag0=0;}	
           			    else if(flag1==7){dog_right_mid_out();flag1=0;flag0=0;}}
			 
	    if(RC_Ctl.rc.ch1>=1300){
			  if(flag0==0){dog_forward_mid_int();flag0=1;}
			  dog_forward_mid(0.00072,0.00036);flag1=8;}//0.00036,0.00018 0.0003,0.000042
			else if(RC_Ctl.rc.ch1<=600){  
				if(flag0==0){dog_back_mid_int();flag0=1;}
				dog_back_mid(0.00072,0.00036);flag1=5;}	//0.00036,0.00018
			else if(RC_Ctl.rc.ch0 <= 600){
				if(flag0==0){dog_left_mid_int();flag0=1;}
				dog_left_mid(0.00108,0.00045);flag1=6;}//0.00036,0.00015 0.00108,0.00045 0.00072,0.0003 0.00072,0.0003
			else if(RC_Ctl.rc.ch0>=1200){
				if(flag0==0){dog_right_mid_int();flag0=1;}
				dog_right_mid(0.00108,0.00045);flag1=7;}//0.00036,0.00015
}	
void dog_mix(void)
{
			if(RC_Ctl.rc.ch3==1024&&RC_Ctl.rc.ch2==1024&&RC_Ctl.rc.ch0==1024&&RC_Ctl.rc.ch1==1024&&flag1!=0){
										if(flag1==8){dog_forward_mid_out();flag1=0;flag0=0;}
										else if(flag1==5){dog_back_mid_out();flag1=0;flag0=0;}
										else if(flag1==6){dog_left_bit_out();flag1=0;flag0=0;}	
           			    else if(flag1==7){dog_right_bit_out();flag1=0;flag0=0;}}
			 
	    if(RC_Ctl.rc.ch1>=1300){
				if(flag_mode==7){dog_left2plank();flag_mode=5;}else if(flag_mode==8){dog_right2plank();flag_mode=5;}			  
				if(flag0==0){dog_forward_mid_int();flag0=1;} dog_forward_mid(0.00072,0.00036);flag1=8;}//0.00036,0.00018 0.0003,0.000042
			else if(RC_Ctl.rc.ch1<=600){  
        if(flag_mode==7){dog_left2plank();flag_mode=5;}else if(flag_mode==8){dog_right2plank();flag_mode=5;}									
				if(flag0==0){dog_back_mid_int();flag0=1;}dog_back_mid(0.00072,0.00036);flag1=5;}	//0.00036,0.00018
			else if(RC_Ctl.rc.ch0<=600){
				if(flag_mode==5){dog_plank2left();flag_mode=7;}else if(flag_mode==8){dog_right2left();flag_mode=7;}
        if(flag0==0){dog_left_bit_int();flag0=1;}dog_left_bit(0.0012,0.0003);flag1=6;}//0.00036,0.00015 0.00108,0.00045 0.00072,0.0003 0.00072,0.0003
			else if(RC_Ctl.rc.ch0>=1200){
				if(flag_mode==5){dog_plank2right();flag_mode=8;}else if(flag_mode==7){dog_left2right();flag_mode=8;}
				if(flag0==0){dog_right_bit_int();flag0=1;}dog_right_bit(0.0012,0.0003);flag1=7;}//0.00036,0.00015
}	
