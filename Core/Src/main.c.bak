								ik_z[0]=-0.219f;ik_z[1]=-0.219f;
								ik_z[2]=-0.219f;ik_z[3]=-0.219f;
								mode=1;}}}
						  else if(flag_mode==1){dog_squat_out();flag_mode=0;}
						  else if(flag_mode==5||flag_mode==7||flag_mode==8){flag_mode=0;}

					 break;}
				   case 3:{
						  mode=0;
              if(flag_mode==0){dog_squat_int();flag_mode=1;}
							else if(flag_mode==2){dog_squat_int_still();flag2=0;flag_mode=1;}//dog_squat_int_still dog_stair_out
							else if(flag_mode==4){dog_stair_out();flag_mode=1;}
							else if(flag_mode==1){
								  if(RC_Ctl.rc.ch3==1024&&RC_Ctl.rc.ch2==1024&&RC_Ctl.rc.ch0==1024&&RC_Ctl.rc.ch1==1024&&flag1==0){dog_squat_int_still();}
									else if(RC_Ctl.rc.ch3==1024&&RC_Ctl.rc.ch2==1024&&RC_Ctl.rc.ch0==1024&&RC_Ctl.rc.ch1==1024&&flag1!=0){
