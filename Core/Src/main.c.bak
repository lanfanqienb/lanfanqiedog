								ik_z_target[2]=-0.219f;ik_z_target[3]=-0.219f;
								ik_z[0]=-0.219f;ik_z[1]=-0.219f;
								ik_z[2]=-0.219f;ik_z[3]=-0.219f;
								mode=1;}}}
							else if(flag_mode==1){dog_squat_out();flag_mode=0;}
							else if(flag_mode==5||flag_mode==7||flag_mode==8){flag_mode=0;}
					 break;}
				   case 3:{
							mode=0;
              if(flag_mode==0){dog_squat_int();flag_mode=1;}
							else if(flag_mode==2){dog_squat_int_still();flag2=0;flag_mode=1;}
							else if(flag_mode==3){dog_squat_int_still();flag2=0;flag_mode=1;}
							else if(flag_mode==1){
								  if(RC_Ctl.rc.ch3==1024&&RC_Ctl.rc.ch2==1024&&RC_Ctl.rc.ch0==1024&&RC_Ctl.rc.ch1==1024&&flag1==0){dog_squat_int_still();}
									else if(RC_Ctl.rc.ch3==1024&&RC_Ctl.rc.ch2==1024&&RC_Ctl.rc.ch0==1024&&RC_Ctl.rc.ch1==1024&&flag1!=0){
											     if(flag1==1){dog_left_mid_out();flag1=0;flag0=0;}
									    else if(flag1==2){dog_right_mid_out();flag1=0;flag0=0;}
									    else if(flag1==3){dog_back_mid_out();flag1=0;flag0=0;}
								    	else if(flag1==4){dog_forward_mid_out();flag1=0;flag0=0;}}
																		
                  if(RC_Ctl.rc.ch3>=1300){
									    if(flag0==0){dog_forward_mid_int();flag0=1;}
							  	    dog_forward_mid(0.00072,0.00036);flag1=4;}//
									else if(RC_Ctl.rc.ch2 <= 600){
											if(flag0==0){dog_left_mid_int();flag0=1;}
											dog_left_mid(0.00108,0.00045);flag1=1;}//0.00072,0.0003
							    else if(RC_Ctl.rc.ch2 >=1200){
											if(flag0==0){dog_right_mid_int();flag0=1;}
											dog_right_mid(0.00108,0.00045);flag1=2;}//0.00072,0.0003   
							    else if(RC_Ctl.rc.ch3<=600){  
											if(flag0==0){dog_back_mid_int();flag0=1;}
											dog_back_mid(0.00108,0.00054);flag1=3;}//0.00072,0.00036
							dog_small_still();}	
							     
					 break;}
				   case 2:{
								mode=0;
						    if(flag_mode==1){
										if(RC_Ctl.rc.ch3>=1300){dog_bunny_jump_up();flag_mode=2;HAL_Delay(600);}//dog_bunny_jump_up()dog_bunny_jump_forward
										else if(RC_Ctl.rc.ch3<=600){dog_bunny_jump_forward7();flag_mode=2;HAL_Delay(600);}
										else if(RC_Ctl.rc.ch2>=1300){dog_bunny_jump_force();flag_mode=3;HAL_Delay(600);}
										else if(RC_Ctl.rc.ch2<=600){dog_bunny_jump_forward2();flag_mode=3;HAL_Delay(600);}
										else if(RC_Ctl.rc.ch1>=1300){dog_jump();flag_mode=3;HAL_Delay(600);}
										else if(RC_Ctl.rc.ch1<=600){dog_jump2(1.7f,2.6f,8.0f);flag_mode=3;HAL_Delay(600);}

								}
								else if(flag_mode==2){
										if(RC_Ctl.rc.ch3==1024&&RC_Ctl.rc.ch2==1024&&RC_Ctl.rc.ch0==1024&&RC_Ctl.rc.ch1==1024&&flag1!=0){
