/* 各腿 IK 高度(z)，0=右后,1=左前,2=左后,3=右前
 * ik_z_target: 期望高度，TIM6 自动平滑插值到达
 * ik_z       : 当前插值状态，与 target 同时赋值可跳过插值直接到位 */
float ik_z_target[4] = {-0.219f, -0.219f, -0.219f, -0.219f};
float ik_z[4]        = {-0.219f, -0.219f, -0.219f, -0.219f};
uint8_t mode = 0; /* 0=位控，1=IK位控站立（各腿独立高度），2=手动步态，5=力控站立 */


/* 力控PD参数（站立）：mode==5 时生�???
 * Kp_z: 弹簧刚度(N/m)，Kd_z: 阻尼(N·s/m)
 * Ff_z: 重力前馈(N)，负值，按实际体重调整（5kg机器人≈-12N/腿） */
FC_PD fc_pd_stand = {
    .Kp_x = 0.0f,   .Kd_x = 5.0f,   .k_x = 0.0f,
    .Kp_z = 200.0f, .Kd_z = 5.0f,   .k_z = 0.0f,
    .Ff_z = -12.0f,
};
